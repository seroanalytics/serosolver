^doc$
^Meta$
^codemeta\.json$
^README\.Rmd$
^for_gpt$

# Local build and check artefacts
^\.git$
^\.gitignore$
^\.DS_Store$
^.*\.DS_Store$
^\.Rhistory$
^.*\.Rhistory$
^\.Rapp\.history$
^.*\.Rapp\.history$
^.*~$
^\.Rcheck$
^\.\.Rcheck$
^src/.*\.(o|so|dll|dylib)$
^src/.*\.o\.tmp$
^vignettes/.*\.(html|pdf)$

# MCMC cache outputs used when knitting locally; do not include these in the package
^inst/extdata/.*/.*_chain\.csv$
^inst/extdata/.*/.*_infection_histories\.csv$
^inst/extdata/.*/.*_log\.txt$
^inst/extdata/.*/.*_serosolver_settings\.RData$
^tests/testthat/tmp.*$
